# Optional configuration for the Marvel Rivals Match & Team Analyzer.
# SQLite needs no server, user name or password, so there are no secrets.
# The app reads this setting from the environment (it does not load .env files itself):
#   macOS/Linux:  MR_DB_PATH=/path/to/file.db python3 main.py
#   Windows PS:   $env:MR_DB_PATH="C:\path\to\file.db"; python main.py
# Leave it unset to use marvel_rivals.db next to main.py.
MR_DB_PATH=marvel_rivals.db
